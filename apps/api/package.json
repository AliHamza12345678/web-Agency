{
  "name": "@openagent/api",
  "version": "0.1.0",
  "type": "module",
  "main": "./src/server.ts",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "pnpm --filter @openagent/core build && pnpm --filter @openagent/db build && pnpm --filter @openagent/ai-provider build && pnpm --filter @openagent/conversation-engine build && pnpm --filter @openagent/knowledge build && pnpm --filter @openagent/tools build && tsc --build --force",
    "start": "node dist/server.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.17",
    "@openagent/ai-provider": "workspace:*",
    "@openagent/conversation-engine": "workspace:*",
    "@openagent/core": "workspace:*",
    "@openagent/db": "workspace:*",
    "@openagent/knowledge": "workspace:*",
    "@openagent/tools": "workspace:*",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.40.0",
    "hono": "^4.13.13",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
