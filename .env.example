# ==============================================================================
# OpenAgent Chat — Environment Configuration Template
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION & SERVER RUNTIME
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=3001
API_URL=http://localhost:3001
WEB_URL=http://localhost:3000
WIDGET_CDN_URL=http://localhost:3001/widget.js

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (PostgreSQL + pgvector)
# Free option: Neon Serverless Postgres (https://neon.tech)
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql://neondb_owner:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_POOL_SIZE=10
DATABASE_SSL=true

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & SECURITY SECRETS
# Generate cryptographically secure keys: openssl rand -hex 32
# ------------------------------------------------------------------------------
JWT_SECRET=replace_with_a_64_character_random_hex_string_for_production
ENCRYPTION_KEY=replace_with_a_32_character_hex_key_for_encrypting_stored_keys
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# ------------------------------------------------------------------------------
# 4. LLM PROVIDERS (Free Tier Supported)
# ------------------------------------------------------------------------------
# Primary Free Provider: Google Gemini (Get key at https://aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Secondary Free Provider: Groq Cloud (Get key at https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Optional Fallback / Enterprise Providers
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest

# ------------------------------------------------------------------------------
# 5. EMBEDDING PROVIDER (Vector RAG)
# ------------------------------------------------------------------------------
# Default: Uses Google Gemini text-embedding-004 (768 dimensions)
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=text-embedding-004
EMBEDDING_DIMENSION=768

# Optional Backup: Hugging Face Serverless
HUGGINGFACE_API_KEY=

# ------------------------------------------------------------------------------
# 6. RATE LIMITING & ABUSE PREVENTION
# ------------------------------------------------------------------------------
RATE_LIMIT_PER_MINUTE_IP=30
RATE_LIMIT_PER_MINUTE_SITE=120

# Optional Redis for distributed multi-instance rate limiting & session cache
# If left empty, API falls back to in-memory sliding-window cache
REDIS_URL=

# ------------------------------------------------------------------------------
# 7. INGESTION & WEB CRAWLER BOUNDS (Free-Tier Protection)
# ------------------------------------------------------------------------------
MAX_PAGES_PER_CRAWL=50
MAX_CHUNK_SIZE_TOKENS=500
CHUNK_OVERLAP_TOKENS=50
MAX_DOCUMENT_SIZE_BYTES=5242880 # 5 MB
