# ==============================================================================
# OpenAgent Chat — Environment Configuration Template
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION & SERVER RUNTIME
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=3001
API_URL=http://localhost:3001
WEB_URL=http://localhost:3000
WIDGET_CDN_URL=http://localhost:3001/widget.js

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (PostgreSQL + pgvector)
# Free option: Neon Serverless Postgres (https://neon.tech)
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql://neondb_owner:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_POOL_SIZE=10
DATABASE_SSL=true

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & SECURITY SECRETS
# Generate cryptographically secure keys: openssl rand -hex 32
# ------------------------------------------------------------------------------
JWT_SECRET=replace_with_a_64_character_random_hex_string_for_production
ENCRYPTION_KEY=replace_with_a_32_character_hex_key_for_encrypting_stored_keys
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# ------------------------------------------------------------------------------
# 4. AI INFERENCE ENGINE & PROVIDERS (100% Free Tiers Supported)
# ------------------------------------------------------------------------------
# Primary & Fallback Selection: 'cloudflare' | 'openrouter' | 'ollama' | 'gemini' | 'groq'
AI_PRIMARY_PROVIDER=cloudflare
AI_PRIMARY_MODEL=@cf/meta/llama-3.1-8b-instruct
AI_FALLBACK_PROVIDER=openrouter
AI_FALLBACK_MODEL=meta-llama/llama-3.3-70b-instruct:free
AI_REQUEST_TIMEOUT_MS=25000
AI_MAX_OUTPUT_TOKENS=1024
AI_DISABLED=false

# 1. Cloudflare Workers AI (Free: 10,000 Neurons/day, no credit card required)
# Get Account ID and API Token from: https://dash.cloudflare.com/
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id_here
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here

# 2. OpenRouter Free Models (Register at https://openrouter.ai and generate free key)
# Free models must end with ':free' (e.g. meta-llama/llama-3.3-70b-instruct:free, google/gemini-2.0-flash-exp:free)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# 3. Local Ollama (Zero cost, local development & self-hosted)
# Download at: https://ollama.ai
OLLAMA_BASE_URL=http://localhost:11434

# 4. Google Gemini & Groq (Alternative Free Providers)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Enterprise BYOK Providers (Optional)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest

# ------------------------------------------------------------------------------
# 5. EMBEDDING PROVIDER (Vector RAG)
# ------------------------------------------------------------------------------
# Default: Uses Google Gemini text-embedding-004 (768 dimensions)
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=text-embedding-004
EMBEDDING_DIMENSION=768

# Optional Backup: Hugging Face Serverless
HUGGINGFACE_API_KEY=

# ------------------------------------------------------------------------------
# 6. RATE LIMITING & ABUSE PREVENTION
# ------------------------------------------------------------------------------
RATE_LIMIT_PER_MINUTE_IP=30
RATE_LIMIT_PER_MINUTE_SITE=120

# Optional Redis for distributed multi-instance rate limiting & session cache
# If left empty, API falls back to in-memory sliding-window cache
REDIS_URL=

# ------------------------------------------------------------------------------
# 7. INGESTION & WEB CRAWLER BOUNDS (Free-Tier Protection)
# ------------------------------------------------------------------------------
MAX_PAGES_PER_CRAWL=50
MAX_CHUNK_SIZE_TOKENS=500
CHUNK_OVERLAP_TOKENS=50
MAX_DOCUMENT_SIZE_BYTES=5242880 # 5 MB
