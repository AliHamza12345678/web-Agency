{
  "name": "openagent-chat",
  "version": "0.1.0",
  "private": true,
  "description": "Production-oriented, multilingual AI chatbot platform with website widget and strict multi-tenancy",
  "type": "module",
  "scripts": {
    "build": "pnpm --recursive run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "tsc --noEmit",
    "dev": "pnpm --parallel --filter @openagent/api --filter @openagent/web dev",
    "dev:api": "pnpm --filter @openagent/api dev",
    "dev:web": "pnpm --filter @openagent/web dev",
    "db:generate": "pnpm --filter @openagent/db db:generate",
    "db:migrate": "pnpm --filter @openagent/db db:migrate",
    "smoke-test": "tsx scripts/smoke-test.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.17",
    "hono": "^4.13.13"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "jsdom": "^30.1.2",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.7"
  },
  "packageManager": "pnpm@11.20.0"
}
